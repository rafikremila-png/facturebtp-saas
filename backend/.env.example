# BTP Facture Backend - Environment Variables
# Copy this file to .env and fill in the values

# MongoDB Connection
MONGO_URL=mongodb+srv://user:password@cluster.mongodb.net/database?retryWrites=true&w=majority
DB_NAME=btp_facture

# CORS - Add your frontend URLs
CORS_ORIGINS=https://your-frontend.onrender.com,http://localhost:3000

# Frontend URL for email links
FRONTEND_URL=https://your-frontend.onrender.com

# JWT Secret - CHANGE THIS IN PRODUCTION
JWT_SECRET=change-this-to-a-secure-random-string

# Admin Account
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=SecurePassword123!
ADMIN_NAME=Super Admin

# Environment
ENVIRONMENT=production

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@yourdomain.com

# Stripe API
STRIPE_API_KEY=sk_live_your_stripe_secret_key

# Stripe Price IDs
STRIPE_PRICE_ESSENTIEL_MONTHLY=price_xxx
STRIPE_PRICE_ESSENTIEL_YEARLY=price_xxx
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_PRO_YEARLY=price_xxx
STRIPE_PRICE_BUSINESS_MONTHLY=price_xxx
STRIPE_PRICE_BUSINESS_YEARLY=price_xxx
